
/*-- WelcomeWidget ----------------------------------------------------------*/

gui--WelcomeWidget > .QPushButton {
    border-radius: 10px;
    border: 2px solid #512DA8;
    color: #263238;
    font-weight: 600;
    font-size: 15px;
}

gui--WelcomeWidget > .QPushButton::hover {
    background-color: #D1C4E9;
}

gui--WelcomeWidget > .QPushButton::pressed {
    background-color: #9575CD;
}

gui--WelcomeWidget > .QLabel {
    font-size: 13px;
}

gui--WelcomeWidget > #title {
    font-size: 25px;
    font-weight: 700;
}

/*-- RebaseSelectionWidget ------------------------------------------*/

gui--rebase--RebaseSelectionWidget QLabel[class="title"] {
    font-size: 18px;
    font-weight: 700;
}

gui--rebase--RebaseSelectionWidget #rebase-selection-message {
    color: #FF7E00;
    font-weight: 700;
}

/*-- QLineEdit ------------------------------------------------------*/

QLineEdit {
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 6px 8px;
}

QLineEdit:focus {
    border: 1px solid palette(highlight);
}

QLineEdit[invalid="true"] {
    border: 1px solid #D9534F;
    background-color: #FFF5F5;
}

QLineEdit[invalid="true"]:focus {
    border: 2px solid #D9534F;
}

/*-- QLabel ---------------------------------------------------------*/

QLabel[role="error"] {
    color: #D9534F;
    font-size: 12px;
}
